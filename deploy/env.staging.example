# Kasir Dapur Backend — STAGING environment
# Copy to server: /etc/dapur-kasir/backend.env
# chmod 600, chown root:dapur-kasir
# NEVER commit this file with real secrets.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
PUBLIC_BASE_URL=https://api-staging.dapur-rasa.com

# SQLite on persistent disk (single instance only)
BILLING_SQLITE_PATH=/var/lib/dapur-kasir/billing.db

# Fail startup if secrets missing/placeholder
ENFORCE_PRODUCTION_SECRETS=true

# Behind nginx on same host
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_IPS=127.0.0.1

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 48
JWT_SECRET=<STAGING_JWT_SECRET_MIN_32_CHARS>

# ── Midtrans SANDBOX (staging) ───────────────────────────────────────────────
MIDTRANS_ENVIRONMENT=SANDBOX
MIDTRANS_SERVER_KEY=<MIDTRANS_SANDBOX_SERVER_KEY>
MIDTRANS_CLIENT_KEY=<MIDTRANS_SANDBOX_CLIENT_KEY>
MIDTRANS_MERCHANT_ID=<MIDTRANS_SANDBOX_MERCHANT_ID>

# Notification URL (register in Midtrans dashboard):
# https://api-staging.dapur-rasa.com/v1/billing/midtrans/notification

# ── Pricing (integer IDR — backend authority) ─────────────────────────────────
PLAN_PRICE_PRO_MONTHLY=49000
PLAN_PRICE_PRO_YEARLY=490000
PLAN_PRICE_BUSINESS_MONTHLY=99000
PLAN_PRICE_BUSINESS_YEARLY=990000
PLAN_GRACE_DAYS=7

# ── Optional integrations ───────────────────────────────────────────────────
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_ACCESS_TOKEN=
BACKUP_BUCKET=

# ── Brand metadata (informational; hardcoded in Brand class today) ───────────
APP_NAME=Kasir Dapur
APP_COMPANY=PT Dapur Rasa Karya Nusantara
APP_OWNER=Mas Rizky Iman
APP_WEBSITE=https://dapur-rasa.com
