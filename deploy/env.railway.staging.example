# Railway staging env template (NO real secrets).
# Set through Railway Variables UI, never commit actual values.

PORT=8080
PUBLIC_BASE_URL=https://api-staging.dapur-rasa.com
BILLING_SQLITE_PATH=/data/billing.db
ENFORCE_PRODUCTION_SECRETS=true

# Keep conservative defaults until Railway proxy topology is verified.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=

JWT_SECRET=<STAGING_JWT_SECRET_MIN_32_CHARS>

# Midtrans sandbox for staging
MIDTRANS_ENVIRONMENT=SANDBOX
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=<MIDTRANS_SANDBOX_SERVER_KEY>
MIDTRANS_CLIENT_KEY=<MIDTRANS_SANDBOX_CLIENT_KEY>
MIDTRANS_MERCHANT_ID=<MIDTRANS_SANDBOX_MERCHANT_ID>

# Pricing authority (unchanged)
PLAN_PRICE_PRO_MONTHLY=49000
PLAN_PRICE_PRO_YEARLY=490000
PLAN_PRICE_BUSINESS_MONTHLY=99000
PLAN_PRICE_BUSINESS_YEARLY=990000
PLAN_GRACE_DAYS=7

# Optional integrations
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_ACCESS_TOKEN=
BACKUP_BUCKET=
