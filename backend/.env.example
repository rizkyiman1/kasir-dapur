# Kasir Dapur backend — PT Dapur Rasa Karya Nusantara
# Salin berkas ini menjadi .env (jangan di-commit).
# Flutter tidak boleh berisi nilai secret di bawah.
#
# Deployment templates (staging/production):
#   deploy/env.staging.example
#   deploy/env.production.example
# VPS install path: /etc/dapur-kasir/backend.env (chmod 600)

APP_NAME=Kasir Dapur
APP_COMPANY=PT Dapur Rasa Karya Nusantara
APP_OWNER=Mas Rizky Iman
APP_WEBSITE=https://dapur-rasa.com

# ── LOCAL DEVELOPMENT defaults ───────────────────────────────────────────────
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
BILLING_SQLITE_PATH=
ENFORCE_PRODUCTION_SECRETS=false
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=

# ── STAGING (see deploy/env.staging.example) ─────────────────────────────────
# PUBLIC_BASE_URL=https://api-staging.dapur-rasa.com
# BILLING_SQLITE_PATH=/var/lib/dapur-kasir/billing.db
# MIDTRANS_ENVIRONMENT=SANDBOX
# ENFORCE_PRODUCTION_SECRETS=true
# TRUST_PROXY_HEADERS=true
# TRUSTED_PROXY_IPS=127.0.0.1

# ── PRODUCTION (see deploy/env.production.example) ───────────────────────────
# PUBLIC_BASE_URL=https://api.dapur-rasa.com
# BILLING_SQLITE_PATH=/var/lib/dapur-kasir/billing.db
# MIDTRANS_ENVIRONMENT=PRODUCTION
# ENFORCE_PRODUCTION_SECRETS=true

# SANDBOX atau PRODUCTION
MIDTRANS_ENVIRONMENT=SANDBOX
# Compatibility flag untuk platform yang hanya memberi boolean:
# MIDTRANS_IS_PRODUCTION=false

# Hanya di backend. Jangan masukkan ke Flutter / dart-define / repo klien.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=

# URL notifikasi yang diisi di dashboard Midtrans:
# {PUBLIC_BASE_URL}/v1/billing/midtrans/notification

# Harga integer Rupiah. Satu tempat konfigurasi. Kosong = checkout ditolak.
PLAN_PRICE_PRO_MONTHLY=49000
PLAN_PRICE_PRO_YEARLY=490000
PLAN_PRICE_BUSINESS_MONTHLY=99000
PLAN_PRICE_BUSINESS_YEARLY=990000
PLAN_GRACE_DAYS=7

# Cloud auth — wajib untuk fitur sync/backup cloud.
# Minimal 32 karakter random. Jangan commit nilai asli.
JWT_SECRET=
# JWT expiry: runtime default 30 hari (JwtService.defaultExpiry).
# JWT_EXPIRES_IN belum dibaca runtime — reserved dokumentasi.
JWT_EXPIRES_IN=2592000
# CORS: saat ini dikonfigurasi di backend HTTP layer (dapur-rasa.com).
# CORS_ALLOWED_ORIGINS reserved dokumentasi deploy edge.
CORS_ALLOWED_ORIGINS=https://dapur-rasa.com
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_ACCESS_TOKEN=
BACKUP_BUCKET=
