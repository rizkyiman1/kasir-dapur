<?xml version="1.0" encoding="utf-8"?>
<!--
    Data Extraction Rules (Android 12+, API 31+)
    Kasir Dapur adalah aplikasi offline-first dengan data sensitif bisnis.
    Backup dan cloud transfer dinonaktifkan untuk melindungi data transaksi.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
